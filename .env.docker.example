# Tastebase Docker environment
# Copy this file to .env next to docker-compose.yml and fill in the blanks.
# Every option is described in docs/environment-variables.md.

# REQUIRED: signs sessions. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# REQUIRED: the address people type to reach Tastebase. Sign-in breaks if it doesn't match.
# Examples:
#   - Local: http://localhost:3000
#   - NAS / home server: http://192.168.1.100:3000
#   - Domain: https://recipes.example.com
BETTER_AUTH_URL=http://localhost:3000

# OPTIONAL: other addresses people use, such as Tailscale. Comma-separated, no spaces.
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.100:3000,http://your-machine.your-tailnet.ts.net:3000

# REQUIRED: encrypts the AI keys people add in Settings.
# Generate a second, different value with: openssl rand -base64 48
ENCRYPTION_SECRET=

# Bump only when rotating ENCRYPTION_SECRET (see docs/security/key-rotation.md)
CURRENT_ENCRYPTION_VERSION=1

# Set to false once everyone has an account. Anyone who can reach Tastebase can
# create an account while this is true. The first account always works.
# ALLOW_SIGN_UPS=false
